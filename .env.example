# Variables de entorno (Vercel → Settings → Environment Variables). Ninguna es obligatoria.

# --- Avisos al celular del chef por ntfy.sh (se leen SOLO en el servidor, nunca llegan al navegador) ---
# Tema del negocio principal. Elegí un nombre largo y difícil de adivinar.
# (También se acepta el nombre viejo VITE_NTFY_TOPIC, así que no hace falta cambiar nada si ya lo cargaste.)
NTFY_TOPIC=
# Opcional: un tema por restaurante, como JSON.
# NTFY_TOPICS={"la-parrilla":"tema-secreto-de-la-parrilla"}
# Opcional: otro servidor ntfy (por defecto https://ntfy.sh).
# NTFY_URL=
